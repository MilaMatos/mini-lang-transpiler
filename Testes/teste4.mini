var x: int = 0;
var y: bool = false;

// erro: atribuição de bool para int
set x = true; 

// erro: variável não declarada
set z = 10; 

def soma(a: int, b: int): int {
    return a + b;
}

// erro: número de argumentos incorreto
print soma(1);

// erro: tipo de argumento incompatível
print soma(true, 2);